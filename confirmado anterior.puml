@startuml DIAGRAMA RELACIONAL SS
skinparam linetype ortho

' =====================
' ENTIDADES
' =====================

entity usuario {
  +id : INT <<PK>>
  --
  rol : VARCHAR(20)
  'GR 01
  correo_institucional : VARCHAR(35) <<UQ>>
  nombre : VARCHAR(50)
  apellidos : VARCHAR(50)
  contraseña : VARCHAR(255)
  'CRED 01
  intentos_fallidos : TINY INT UNSIGNED
  cuenta_bloqueada : TINY INT(1) 
  fecha_bloqueo : DATETIME NULL
  'cred 03
  fecha_creacion : DATETIME
  creado_por_id: INT UNSIGNED NULL <<FK>>
  'REP-01, REP-05 
  rubrica_imagen : VARCHAR(500)
  'rubrica_hash: VARCHAR(64)
  rubrica_ip: VARCHAR(45) 
  rubrica_fecha_registro: DATETIME
}

entity alumno {
  +  boleta: char(10) UNIQUE <<PK>>
  --
  usuario_id : INT UNIQUE <<FK>>
  celular : VARCHAR(10)
  carrera : VARCHAR(3)
  'cambio real: era TINY INT UNSIGNED, ahora admite decimales (ej. 85.50)
  creditos : DECIMAL(5,2)
  semestre : TINY INT UNSIGNED
  'ADM-03, ADM-04
  correo_personal : VARCHAR(50) NULL

}

entity profesor{
  +id : INT <<PK>>
  --
  usuario_id : INT UNIQUE <<FK>>
  'CRED-03
  departamento : VARCHAR(100)
  'ADM-01, ADM-12
  telefono_personal : VARCHAR(10)
  horario_atencion : VARCHAR(100)
  cubiculo : VARCHAR(100)
  'cupos_totales = 3 (base) + incremento de la característica vigente
  cupos_totales: TINY INT UNSIGNED
  'NUEVO campo: característica institucional vigente (0 o 1 a la vez)
  caracteristica_id : INT NULL <<FK>>
}

entity coordinador {
  +id : INT <<PK>>
  --
  usuario_id : INT UNIQUE <<FK>>
}

entity inicio_sesion {
  +id : INT <<PK>>
  --
  usuario_id : INT UNSIGNED <<FK>>
  'renombrado: antes fecha_hora
  fecha_hora_acceso : DATETIME
  ip_acceso : VARCHAR(45)
  resultado : TINY INT(1)
}

entity token_contraseña{
  +id : INT <<PK>>
  --
  usuario_id : INT UNSIGNED <<FK>>
  token : VARCHAR(255)
  fecha_expiracion : DATETIME
  usado: TINY INT(1)
}

entity oferta_servicio{
  +id : INT <<PK>>
  --
  profesor_id : INT <<FK>>
  'ahora NULL mientras la oferta está pendiente_revision
  coordinador_id : INT NULL <<FK>>
  'GR-04 y *PRO-01
  nombre_SISS: VARCHAR(100) NULL
  'NUEVO campo
  programa_SISS: VARCHAR(150) NULL
  'PRO-01
  nombre_proyecto : VARCHAR(150)
  tipo_oferta : ENUM('individual','proyecto')
  descripcion_actividades: TEXT
  'GR-02 y PRO-01
  cupos_ofertados: TINY INT UNSIGNED NULL
  'ELIMINADO: cupos_investigador ya no existe en el esquema real
  cupos_disponibles: TINY INT UNSIGNED
  'LSS-01  **
  estado_oferta: VARCHAR(20)
  fecha_registro : DATETIME
  'PRO-02
  motivo_rechazo : TEXT NULL
}
'estados: pendiente_revision, aprobada, rechazada,  concluida, cerrada

entity solicitud_registro {
  +id : INT <<PK>>
  --
  'corregido: la FK apunta a alumno.boleta (CHAR(10)), no es INT
  alumno_id : CHAR(10) UNIQUE <<FK>>
  carrera_id : INT <<FK>>
  'GR-01
  dictamen : TINY INT UNSIGNED NULL
  periodo_registro_id : INT NULL <<FK>>
  oferta_id : INT NULL <<FK>>
  motivacion_oferta : TEXT NULL
  estado_solicitud : VARCHAR(50)
  estado_anterior : VARCHAR(50) NULL
  fecha_aplicacion : DATETIME
  'GR-02
  tipo_rechazo: VARCHAR(50) NULL
  motivo_rechazo : TEXT NULL
  'GR-04
  registro_siss : TINYINT (1)
  'GR-05
  docs_iniciales : TINYINT (1)
  'GR-08
  carta_compromiso : TINYINT (1)
  'NUEVO campo
  fecha_carta_compromiso : DATETIME NULL
  'GR-11
  expediente: TINYINT (1)
}


entity actividad {
  +id : INT <<PK>>
  --
  solicitud_registro_id : INT <<FK>>
  'AH-01
  titulo : VARCHAR(150)
  descripcion : TEXT
  entregable_esperado : TEXT
  fecha_limite : DATE
  estado : VARCHAR(20)
  fecha_asignacion : DATETIME
  'AH-02
  porcentaje_progreso : TINYINT UNSIGNED
  fecha_completada : DATETIME NULL
  'AH-06
  fecha_limite_original : DATE NULL
}
'estado: sin_comenzar, en_progreso, vencida, completada_en_tiempo, completada_fuera_de_tiempo

entity bitacora {
  +id : INT <<PK>>
  --
  solicitud_registro_id : INT <<FK>>
  'AH-03
  hora_inicio : DATETIME
  'NULL mientras la jornada sigue 'en_curso'
  hora_fin : DATETIME NULL
  horas_contabilizadas : TINYINT UNSIGNED NULL
  estado : VARCHAR(30)
  fecha_registro : DATE
  'AH-04
  motivo_rechazo : TEXT NULL
  fecha_revision : DATETIME NULL
  revisado_por_id : INT <<FK>> NULL
}
'ESTADO: En curso, Pendiente de revisión, Aprobada, Rechazada


entity registro_bitacora_actividades {
  +id : INT <<PK>>
  --
  bitacora_id : INT <<FK>>
  actividad_id : INT <<FK>>
  'AH-03
  descripcion : TEXT
  porcentaje_avance_registrado : TINYINT UNSIGNED
  evidencia : TEXT
  --
  <<UNIQUE>> (bitacora_id, actividad_id)
}

entity reporte_mensual{
  +id : INT <<PK>>
  --
  solicitud_registro_id : INT <<FK>>
  documento_id : INT UNIQUE <<FK>>
  'REP-01
  num_reporte : TINYINT UNSIGNED
  actividades_mes: TEXT
  'NUEVOS campos: snapshot del primer envío, nunca se recalculan
  dias_laborados: TINYINT UNSIGNED
  horas_reportadas: SMALLINT UNSIGNED
  estado_reporte: VARCHAR(35)
}

entity reporte_global{
  +id : INT <<PK>>
  --
  solicitud_registro_id : INT <<FK>>
  documento_id : INT UNIQUE <<FK>>
  'REP-07
  actividades_resumen: TEXT
  estado_reporte: VARCHAR(35)
}

entity revision_reporte_mensual {
  +id : INT <<PK>>
  --
  reporte_mensual_id : INT <<FK>>
  usuario_id : INT <<FK>>
  tipo_revisor: ENUM('alumno','profesor','coordinador')
  estado: ENUM('aprobado','rechazado')
  comentario: TEXT NULL
  hash_documento: VARCHAR(64) NULL
  'NUEVO campo
  ruta_archivo: VARCHAR(255)
  ip_firma: VARCHAR(45) NULL
  token_tsa: TEXT NULL
  fecha: DATETIME
}

entity revision_reporte_global {
  +id : INT <<PK>>
  --
  reporte_global_id : INT <<FK>>
  usuario_id : INT <<FK>>
  tipo_revisor: ENUM('alumno','profesor','coordinador')
  estado: ENUM('aprobado','rechazado')
  comentario: TEXT NULL
  hash_documento: VARCHAR(64) NULL
  'NUEVO campo
  ruta_archivo: VARCHAR(255)
  ip_firma: VARCHAR(45) NULL
  token_tsa: TEXT NULL
  fecha: DATETIME
}

entity documento {
  +id : INT <<PK>>
  --
  'corregido: la FK apunta a alumno.boleta (CHAR(10)), no es INT
  alumno_id : CHAR(10) <<FK>>
  creador_id : INT <<FK>>
  'GR-05, en REP-01 y 07 tipo_documento: 'reporte_mensual' y 'reporte_global' 
  'ruta_archivo y fecha_creacion tambien para reportes
  tipo_documento : VARCHAR(50)
  fecha_creacion : DATETIME
  estado_documento : VARCHAR (20)
  ruta_archivo : VARCHAR(255) 
  'GR-07
  aprobado_por_id : INT <<FK>> NULL
  'GR-10
  nombre_expediente: VARCHAR(100) NULL
}

'estado_documento puede ser: "en revision", "aprobado", "rechazado", "con_correciones"

entity cumulo_horas_y_faltas {
  +id : INT <<PK>>
  --
  'corregido: la FK apunta a alumno.boleta (CHAR(10)), no es INT
  alumno_id : CHAR(10) UNIQUE <<FK>>
  'AH-03
  horas_acumuladas : SMALLINT UNSIGNED
  horas_rechazadas : SMALLINT UNSIGNED
  'AH-04
  faltas_acumuladas : TINYINT UNSIGNED
  faltas_consecutivas : TINYINT UNSIGNED
  'NUEVO campo: último día ya evaluado por el cron de faltas
  fecha_ultima_evaluacion_faltas : DATE NULL
}

' carrera DESEADO
entity carrera {
  +id : INT <<PK>>
  --
  nombre : VARCHAR(3)
}
entity deseo_de_carrera {
  + id : INT <<PK>>
  --
  oferta_id : INT <<FK>>
  carrera_id : INT <<FK>>
  --
  <<UNIQUE>> (oferta_id, carrera_id)
}

' profesorCARACTERISTICA

entity caracteristica {
  +id : INT <<PK>>
  --
'ADM-17 — NUEVOS valores agregados: Funcionario, Profesor coordinador de clubes
  nombre : ENUM('Presidente de academia','Coordinador'
  ,'Jefe de departamento','Investigador','Funcionario'
  ,'Profesor coordinador de clubes')
  incremento_cupos: TINYINT UNSIGNED
}

entity solicitud_caracteristica {
  +id : INT <<PK>>
  --
  profesor_id : INT <<FK>>
  'NULL = solicitud para volver a Profesor base
  caracteristica_id : INT NULL <<FK>>
'ADM-17
  justificacion : TEXT
  estado : VARCHAR(30)
  fecha : DATETIME
  'ADM-18
  comentario : TEXT NULL
  fecha_respuesta : DATETIME NULL
}
'estados: pendiente, aprobada, rechazada

' CALENDARIO

entity evento_calendario{
  +id : INT <<PK>>
  --
  coordinador_id : INT <<FK>>
  'ADM-09
  nombre : VARCHAR(150)
  tipo : ENUM('Vacacional','Inhabil','Periodo')
  'para inhabil fecha_inicio representa el día inhábil y fecha_fin queda NULL
  fecha_inicio : DATE 
  'solo vacacional o periodo
  fecha_fin : DATE NULL
  'solo inhabil
  hora : TIME NULL
}

entity periodo_registro {
  +id : INT <<PK>>
  --
  evento_calendario_id : INT <<FK, UNIQUE>>
  anio : CHAR(4)
  semestre : ENUM('01','02')
  fecha_max_expediente : DATE
}

' RECURSO
entity recurso {
  +id : INT <<PK>>
  --
  coordinador_id : INT <<FK>>
  'ADM-06
  nombre : VARCHAR(150)
  url : VARCHAR(500)
  'NUEVO campo: recursos con propósito especial que el sistema consulta por código
  tipo : ENUM('link_constancia_creditos','link_siss','link_seguro_social') UNIQUE NULL
  fecha_registro : DATETIME
  fecha_actualizacion : DATETIME NULL
}

entity contacto_institucional{
  +id : INT <<PK>>
  --
  coordinador_id : INT <<FK>>
  'ADM-07
  tipo : ENUM('correo','telefono','ubicacion','horario')
  valor : VARCHAR(255)
  fecha_actualizacion : DATETIME
}


' ANUNCIOS
entity anuncio {
  +id : INT <<PK>>
  --
  usuario_id : INT <<FK>>
  'ADM-08, ADM-11
  titulo : VARCHAR(150)
  contenido : TEXT
  fecha_publicacion : DATETIME
  origen : ENUM('coordinador','profesor') 
}

entity registro_anuncio_visto {
  +id : INT <<PK>>
  --
  'corregido: la FK apunta a alumno.boleta (CHAR(10)), no es INT
  alumno_id : CHAR(10) <<FK>>
  anuncio_id : INT <<FK>>
  <<UNIQUE>> (alumno_id, anuncio_id)
}

' NOTIFICACIONES (NUEVA tabla, no existía en la versión anterior)
entity notificacion {
  +id : INT <<PK>>
  --
  usuario_id : INT <<FK>>
  tipo : VARCHAR(20)
  mensaje : TEXT
  ruta_relacionada : VARCHAR(255) NULL
  leida : TINYINT(1)
  fecha_creacion : DATETIME
  fecha_leida : DATETIME NULL
}
'tipo puede ser: info, warning, urgente, success

' LSS
entity liberacion_proceso {
  +id : INT <<PK>>
  --
  solicitud_registro_id : INT UNIQUE <<FK>>
  'LSS-01
  estado : VARCHAR(50)
  fecha_inicio : DATETIME
  reportes_validados_siss : TINYINT(1)
  'LSS-02
  evaluacion_subida_siss : TINYINT(1) NULL
  evaluacion_descargada : TINYINT(1) NULL 
  'LSS-05
  carta_termino_recogida : TINYINT(1) NULL 
  'LSS-07
  expediente_enviado : TINYINT(1) NULL
  observaciones_rechazo : TEXT NULL
  'NUEVO campo (LSS-11): mensaje de texto libre que coordinación redacta,
  'incluye el link a serviciosocialconstancias.ipn.mx embebido en el texto.
  'LA CONSTANCIA YA NO ES UN ARCHIVO — nunca se crea un documento para ella.
  mensaje_constancia_termino : TEXT NULL
}

entity evaluacion_desempeño {
  +id : INT <<PK>>
  --
  'ahora NULL: un rechazo por SISS nunca tiene documento real detrás
  documento_id : INT UNIQUE NULL <<FK>>
  liberacion_proceso_id : INT UNIQUE <<FK>>
  'LSS-03
  estado : VARCHAR(50)
  observaciones_profesor : TEXT NULL
  reportes_siss_confirmados : TINYINT(1)
  fecha_evaluacion : DATETIME NULL
  motivo_rechazo_coordinacion : TEXT NULL
  'NUEVO campo: puntajes capturados en el formulario del profesor (LSS-03),
  'objeto fijo de 7 factores -> puntaje, nunca se normaliza en tabla aparte
  puntajes_factores : JSON NULL
}
'evaluacion_solicitada
'rechazada_por_siss
'pendiente_dictamen
'devuelta_para_correccion
'aprobado_coordinador (corregido: antes decía firmada_coordinacion, no coincide con el código real)

entity revision_desempeño {
  +id : INT <<PK>>
  --
  evaluacion_desempeño_id : INT <<FK>>
  usuario_id : INT <<FK>>
  'LSS-02
  tipo_revisor : VARCHAR(20)
  estado : VARCHAR(20)
  comentario : TEXT NULL
  hash_documento : VARCHAR(64) NULL
  'hash_rubrica : VARCHAR(255) NULL
  ip_firma : VARCHAR(45) NULL
  token_tsa : TEXT NULL
  fecha : DATETIME
}
'tipo revisor puede ser: alumno, profesor, coordinador
'estado puede ser: aprobado


entity solicitud_baja {
  +id : INT <<PK>>
  --
  'corregido: la FK apunta a alumno.boleta (CHAR(10)), no es INT
  alumno_id : CHAR(10) <<FK>>
  solicitante_id : INT <<FK>>
  coordinador_id : INT NULL <<FK>>
  documento_id : INT <<FK>> NULL
  estado : VARCHAR(12)
  motivo : TEXT
  fecha : DATETIME
  'NUEVOS campos: resolución de coordinación
  fecha_respuesta : DATETIME NULL
  comentario : TEXT NULL
}
'estados: pendiente, en_revision, aprobada, rechazada



entity carta_termino {
  +id : INT <<PK>>
  --
  liberacion_proceso_id : INT UNIQUE <<FK>>
  'LSS-05
  estado : VARCHAR(50)
  carta_recogida : TINYINT(1)
  fecha_disponible : DATETIME NULL
  fecha_recogida : DATETIME NULL
  'LSS-06
  fecha_solicitud : DATETIME
}



' =====================
' RELACIONES
' =====================

'SOLICITUD DE BAJA
' cardinalidad corregida: alumno.solicitud_baja es un arreglo (1:N) en el schema,
' alumno_id NO es UNIQUE en solicitud_baja — un alumno puede tener historial de varias
alumno ||--o{ solicitud_baja : "1:N \n corresponde"
usuario ||--o{ solicitud_baja : "1:N \n solicita"
' cardinalidad corregida: coordinador_id es NULL hasta que se resuelve la solicitud
' ("al crear la solicitud todavía no hay coordinador; se fija al resolverla")
coordinador |o--o{ solicitud_baja : "0..1:N \n gestiona"
' cardinalidad corregida: documento.solicitud_baja es un arreglo en el schema — un mismo
' documento podría, a nivel de FK, quedar referenciado por más de una solicitud_baja
' (aunque en la práctica bajas.service.js siempre crea un documento nuevo por solicitud)
documento |o--o{ solicitud_baja : "0..1:N \n pertenece"

' USUARIO 
usuario ||--o{ token_contraseña : "1:N \n genera"
usuario ||--o{ inicio_sesion : "1:N \n registra"


usuario ||--|| alumno: "1:1 \n es un"

usuario ||--|| profesor: "1:1 \n es un"
usuario ||--|| coordinador : "1:1 \n es un"


usuario ||--o{ anuncio : "1:N \n publica"
usuario ||--o{ documento : "1:N \n crea"
usuario ||--o{ revision_reporte_mensual : "1:N \n registra"
usuario ||--o{ revision_reporte_global : "1:N \n registra"
' NUEVA relación
usuario ||--o{ notificacion : "1:N \n recibe"



' REPORTE
reporte_mensual ||--o{ revision_reporte_mensual : "1:N \n tiene"

reporte_mensual ||--|| documento : "1:1 \n es un"

reporte_global ||--o{ revision_reporte_global : "1:N \n resume"
reporte_global ||--|| documento : "1:1 \n es un"




'ALUMNO
alumno ||--o{ documento : "1:N \n corresponde"
alumno ||--|| cumulo_horas_y_faltas : "1:1 \n tiene"
alumno ||--o{ registro_anuncio_visto : "1:N \n genera"
alumno ||--|| solicitud_registro : "1:1 \n corresponde"


'ANUNCIO
anuncio ||--o{ registro_anuncio_visto : "1:N \n tiene"

' PROFESOR
profesor ||--o{ oferta_servicio: "1:N \n corresponde"
profesor ||--o{ solicitud_caracteristica : "1:N \n tiene"  
profesor ||--o{ bitacora : "1:N \n revisa"
profesor ||--o{ actividad : "1:N \n asigna"

'CARACTERISTICA
caracteristica ||--o{ solicitud_caracteristica : "1:N \n corresponde"
' NUEVA relación: característica institucional vigente del profesor
caracteristica |o--o{ profesor : "1:N \n vigente en"

'OFERTA
oferta_servicio ||--o{ deseo_de_carrera : "1:N \n registra"
oferta_servicio ||--o{ solicitud_registro: "1:N \n tiene"


'COORDINADOR
coordinador ||--o{ oferta_servicio: "1:N \n revisa"
coordinador ||--o{ recurso: "1:N \n gestiona "
coordinador ||--o{ evento_calendario: "1:N \n gestiona"


coordinador ||--o{ usuario : "1:N \n crea"
coordinador ||--o{ documento : "1:N \n revisa"

coordinador ||--o{ contacto_institucional : "1:N \n gestiona"

'CARRERA
carrera ||--o{ deseo_de_carrera : "1:N \n se requiere"
carrera ||--o{ solicitud_registro: "1:N \n se requiere"

' SOLICITUD
solicitud_registro }o--|| periodo_registro : "N:1 \n escoge"
solicitud_registro ||--o{ bitacora : "1:N \n le corresponde"
solicitud_registro ||--o{ actividad : "1:N \n le corresponde"
solicitud_registro ||--|| liberacion_proceso : "1:1 \n solicita"
solicitud_registro ||--o{ reporte_mensual: "1:N \n le corresponde"
' cardinalidad fiel al schema real: reporte_global.solicitud_registro_id NO tiene
' @unique (es 1:N a nivel de BD). En la práctica SIEMPRE es 1:1 — lo garantiza un
' lock de aplicación (SELECT FOR UPDATE + chequeo en registrarEnvioGlobal, con test
' de concurrencia que lo confirma) y la corrección de CU-REP-04 nunca crea una
' segunda fila, siempre actualiza la existente. El propio código reconoce la falta
' del @unique en un comentario ("la tabla no tiene UNIQUE: se garantiza con el
' bloqueo de la solicitud") — es una brecha de integridad pendiente, no un diseño
' 1:N intencional.
solicitud_registro ||--o{ reporte_global: "1:N \n le corresponde"


' BITACORA
bitacora ||--o{ registro_bitacora_actividades : "1:N \n contiene"
actividad ||--o{ registro_bitacora_actividades : "1:N \n es registrada en"


'EVALUACIÓN_DESEMPEÑO
' cardinalidad corregida: documento_id ahora es NULL (rechazo por SISS sin documento)
evaluacion_desempeño |o--o| documento : "0..1:0..1 \n es un"
evaluacion_desempeño ||--o{ revision_desempeño : "1:N \n tiene"
usuario ||--o{ revision_desempeño : "1:N \n registra"

'LIBERACIÓN_PROCESO
liberacion_proceso ||--|| evaluacion_desempeño : "1:1 \n corresponde"
liberacion_proceso ||--|| carta_termino : "1:1 \n tiene"

'CALENDARIO - PERIODO PRESTACIÓN
evento_calendario ||--|| periodo_registro : "1:1 \n es un"

@enduml